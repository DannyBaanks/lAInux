# shellcheck shell=bash
# Pinned inputs of the Kimi recipe, checked on 2026-11-14.
# - The Kimi installer is where kimi.com's "Download for Windows" button lands
#   (appsupport.moonshot.cn/api/app/pkg/latest/windows/download -> 302). Its MD5 is
#   the ETag Moonshot's CDN serves for it; the SHA-256 was computed on that
#   download after the MD5 matched.
# - Electron, python-build-standalone and uv against their GitHub release checksums;
#   @node-rs/jieba-linux-x64-gnu against the npm registry's shasum for 2.0.4.

KIMI_TITLE="Kimi"
KIMI_VERSION="3.2.27"
KIMI_EXE_URL="https://kimi-img.moonshot.cn/app/download/windows/kimi_3.2.27.exe"
KIMI_EXE_MD5="a40b14afb2cf73d0f66919c894a1e1dc"
KIMI_EXE_SHA256="91437498a5326b3d74ca98e19296ad440c0cc706392258a294f9d13a39731bac"

# Kimi.exe 3.2.27 reports Chrome/150.0.7871.250 Electron/43.7.7.
ELECTRON_VERSION="43.7.7"
ELECTRON_URL="https://github.com/electron/electron/releases/download/v$ELECTRON_VERSION/electron-v$ELECTRON_VERSION-linux-x64.zip"
ELECTRON_SHA256="4d0a48398c444258dbcf2f5f83b49ca5bc53583130f354e0c299dad5b22b5271"

# Kimi Work's local agent (daimon 1.0.10) is JavaScript run by Kimi's own Electron
# as Node, plus CPython and uv. The Windows package ships Windows builds of those
# two and of jieba's addon; their Linux builds are used instead (CPython is the
# python-build-standalone release the daimon bundle README names).
PYTHON_TAG="20261110"
PYTHON_URL="https://github.com/astral-sh/python-build-standalone/releases/download/$PYTHON_TAG/cpython-3.12.16%2B$PYTHON_TAG-x86_64-unknown-linux-gnu-install_only.tar.gz"
PYTHON_SHA256="c2f87d4b4e8db3abddb0f116c6ccfc503d0cbdbb9ee8faacddad1b679ec12e99"
UV_VERSION="0.12.17"
UV_URL="https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-x86_64-unknown-linux-gnu.tar.gz"
UV_SHA256="fa82fd8dde8e8eefdecada6aa0889666556cfceb690d06e0c3bca49eb3070a63"
JIEBA_VERSION="2.0.4"
JIEBA_URL="https://registry.npmjs.org/@node-rs/jieba-linux-x64-gnu/-/jieba-linux-x64-gnu-$JIEBA_VERSION.tgz"
JIEBA_SHA256="09d06c0f2f9310c512db3efc0eb28e44e321a32b38a56d29c692d4d50e61debd"
