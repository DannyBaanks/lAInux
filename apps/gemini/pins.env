# shellcheck shell=bash
# Pinned inputs of the Gemini recipe, checked on 2026-11-14:
# - the Gemini package hash is the one Google's own update server (Omaha,
#   update.googleapis.com/service/update2/json) returns in its manifest for
#   appid {533DD80C-942A-4464-B6A9-2E59428D784E}, ap=prod — the same answer the
#   official GeminiSetup.exe stub gets before downloading;
# - Electron against github.com/electron/electron SHASUMS256.txt.

GEMINI_TITLE="Gemini"
GEMINI_APPID="{533DD80C-942A-4464-B6A9-2E59428D784E}"
GEMINI_VERSION="1.19.0"
GEMINI_CRX_URL="https://dl.google.com/release2/Google%20DeepMind/aczdqjazqi6kz6sm2luwgnoejoxa_1.19.0/-533dd80c-942a-4464-b6a9-2e59428d784e-_1.19.0_all_aynb2k26te3pzeqrmzft3xwor4.crx3"
GEMINI_CRX_SHA256="a816fdfe144c4137daaccde09ac0c1a390cd59b6330e8b1861f3e6173eaeeac2"
GEMINI_SETUP_NAME="GeminiSetup-1.19.0_uncompressed.exe"

# Gemini.exe 1.19.0 reports Electron/44.6.0.
ELECTRON_VERSION="44.6.0"
ELECTRON_URL="https://github.com/electron/electron/releases/download/v$ELECTRON_VERSION/electron-v$ELECTRON_VERSION-linux-x64.zip"
ELECTRON_SHA256="20cafbe96e0ab8ad95cd31804acd683142b361f9e25f1595aecf67177d0a8915"
