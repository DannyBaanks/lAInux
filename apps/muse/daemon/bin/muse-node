#!/usr/bin/env node
'use strict';

const path = require('node:path');
const { brokerRequest } = require('../../client/broker');
const { JsonStreamParser } = require('../lib/json-stream');
const { connectPrimaryGateway } = require('../lib/primary');
const { NoiseRpcClient } = require('../lib/rpc');
const fs = require('node:fs');
const { createCommandRegistry, killAllProcessGroups } = require('../lib/commands');
const { InvokeLedger } = require('../lib/invoke-ledger');
const { NodeStatus, defaultStatusPath } = require('../lib/node-state');
const { WorkspaceAuthority, GRANT_ALIASES, defaultStateDirectory } = require('../lib/workspace-authority');
const { ReceiptLog } = require('../lib/receipts');

function receiptsFile() { return path.join(defaultStateDirectory(), 'receipts', 'muse-node.jsonl'); }
const { MuseNodeService } = require('../lib/node-service');
const { createZenityChannel } = require('../lib/approval');
const { createApprovalBroker } = require('../lib/approval-broker');
const { FlowMode, parseMinutes } = require('../lib/flow');
const telegram = require('../lib/telegram');
const keyring = require('../lib/keyring');

const TELEGRAM_ACCOUNT = 'telegram-bot-token';
function flowFile() { return path.join(defaultStateDirectory(), 'flow.json'); }
const { defaultProfile, loadOrCreateIdentity } = require('../lib/store');

async function openGateway(profile, { cold = false } = {}) {
  const identity = loadOrCreateIdentity(profile);
  console.log(`[muse-node] identity ${identity.nodeId} (${identity.displayName})`);
  console.log(`[muse-node] requesting ${cold ? 'cold-CVM' : 'standard VM'} credentials from the Muse shell…`);
  const method = cold ? 'credentials.coldLease' : 'credentials.standardSession';
  const session = await brokerRequest(profile, method, {}, { timeoutMs: 120000 });
  console.log(`[muse-node] VM ${session.vmId}; opening Noise_XX_25519_AESGCM_SHA256…`);
  let connection;
  try {
    connection = await connectPrimaryGateway({ session, recoverySecret: identity.recoverySecret });
  } catch (error) {
    console.error(`[muse-node] handshake failed: ${error.code ?? error.name}: ${error.message}`);
    if (error.rvState) console.error(`[muse-node] server RV state: ${error.rvState}`);
    throw error;
  }
  console.log(`[muse-node] handshake OK: type=${connection.observedType} rv=${connection.rvChallenge?.state ?? 'none'}`);
  return { identity, session, connection, rpc: new NoiseRpcClient(connection) };
}

function reportRpcError(connection, error) {
  console.error(`[muse-node] RPC failed: ${error.message}`);
  if (connection.lastFrameError) console.error(`[muse-node] frame error: ${connection.lastFrameError.stack}`);
  if (connection.closeInfo) console.error(`[muse-node] close: ${JSON.stringify(connection.closeInfo)}`);
}

async function subscribe(rpc, onEvent = null, nodeId = null) {
  const parser = new JsonStreamParser();
  return rpc.subscribe({
    method: 'POST',
    path: '/chat/subscribe',
    params: nodeId ? { node_id: nodeId } : {},
    onBodyChunk: async (data) => {
      for (const event of parser.push(data)) {
        if (onEvent) await onEvent(event);
        else if (process.env.MUSE_DEBUG_SUBSCRIPTION === '1') console.log(`[muse-node] event ${event.event ?? event.type ?? 'subscription.ready'}`);
      }
    },
    onStreamError: (error) => console.error(`[muse-node] chat.subscribe ended: ${error.message}`),
  });
}

function nodeSummary(node) {
  return {
    node_id: node.node_id,
    display_name: node.display_name,
    platform: node.platform,
    online: node.online,
    connection_state: node.connection_state,
    pairing_status: node.pairing_status,
    commands: Object.keys(node.commands_v2 ?? {}),
  };
}

async function listNodes(rpc) {
  const response = await rpc.requestJson({ method: 'POST', path: '/api/nodes/list', params: {} });
  const nodes = response.json?.nodes ?? [];
  console.log(`[muse-node] node.list HTTP ${response.status}: ${JSON.stringify(nodes.map(nodeSummary))}`);
  return nodes;
}

async function probe(profile, options = {}) {
  const { connection, rpc } = await openGateway(profile, options);
  try {
    const response = await rpc.requestJson({ method: 'POST', path: '/api/ping' });
    console.log(`[muse-node] connection.ping HTTP ${response.status}: ${JSON.stringify(response.json)}`);
  } catch (error) {
    reportRpcError(connection, error);
    throw error;
  } finally {
    rpc.close();
    connection.close();
  }
}

async function register(profile, options = {}) {
  const { identity, connection, rpc } = await openGateway(profile, options);
  let heartbeat = null;
  try {
    const subscription = await subscribe(rpc, async (event) => {
      if (event.event === 'node.connected') {
        console.log(`[muse-node] node.connected: ${JSON.stringify(event.payload)}`);
      } else if (event.event === 'client.invoke') {
        console.log(`[muse-node] client.invoke: ${JSON.stringify({ command_id: event.payload?.command_id, invoke_id: event.payload?.invoke_id })}`);
      } else if (process.env.MUSE_DEBUG_SUBSCRIPTION === '1') {
        console.log(`[muse-node] event ${event.event ?? event.type ?? 'subscription.ready'}`);
      }
    }, identity.nodeId);
    console.log(`[muse-node] chat.subscribe HTTP ${subscription.status}; stream ${subscription.streamId} active`);
    const registration = await rpc.requestJson({
      method: 'POST',
      path: '/api/nodes/register',
      params: {
        node_id: identity.nodeId,
        display_name: identity.displayName,
        platform: 'linux',
        commands_v2: { ping: { description: 'Connection liveness check' } },
      },
    });
    console.log(`[muse-node] node.register HTTP ${registration.status}: ${JSON.stringify(registration.json)}`);
    const beat = await rpc.requestJson({ method: 'POST', path: '/api/nodes/heartbeat', params: { node_id: identity.nodeId } });
    console.log(`[muse-node] node.heartbeat HTTP ${beat.status}: ${JSON.stringify(beat.json)}`);
    await listNodes(rpc);
    if (options.stayMs > 0) {
      console.log(`[muse-node] staying online for ${options.stayMs} ms…`);
      heartbeat = setInterval(async () => {
        try {
          await rpc.requestJson({ method: 'POST', path: '/api/nodes/heartbeat', params: { node_id: identity.nodeId } });
          console.log('[muse-node] heartbeat ok');
        } catch (error) { console.error(`[muse-node] heartbeat failed: ${error.message}`); }
      }, 15000);
      await new Promise((resolve) => setTimeout(resolve, options.stayMs));
    }
  } catch (error) {
    reportRpcError(connection, error);
    throw error;
  } finally {
    if (heartbeat) clearInterval(heartbeat);
    rpc.close();
    connection.close();
  }
}

async function nodes(profile, options = {}) {
  const { connection, rpc } = await openGateway(profile, options);
  try {
    await subscribe(rpc);
    await listNodes(rpc);
  } catch (error) {
    reportRpcError(connection, error);
    throw error;
  } finally {
    rpc.close();
    connection.close();
  }
}

// Long-running node: one gateway session at a time. A session ends when the
// socket closes OR the service reports it lost (subscription stream ended,
// heartbeats failing, capabilities not accepted): an open socket alone is not
// "online". Reconnect with capped exponential backoff plus jitter. Invocations
// live in a process-wide ledger so a redelivery after reconnect replays the
// stored result instead of running the command twice.
//   SIGUSR2  drop the current gateway session on purpose (reconnect test)
function backoffWithJitter(baseMs, random = Math.random) {
  return Math.round(baseMs / 2 + random() * baseMs / 2);
}

async function start(profile, options = {}) {
  const status = new NodeStatus();
  const ledger = new InvokeLedger();
  // One authority + receipt chain for the whole process; the policy file is
  // re-read on every decision, so `muse-node revoke/lock` apply immediately.
  const authority = new WorkspaceAuthority();
  const receipts = new ReceiptLog({ file: receiptsFile() });
  const flow = new FlowMode({ file: flowFile() });
  // Approval channels the model cannot reach: the desktop dialog and, when
  // paired, the private Telegram chat. First explicit answer wins.
  const channels = [createZenityChannel()];
  const phone = openTelegramChannel({ flow, authority });
  if (phone) channels.push(phone.start());
  const approve = createApprovalBroker({ channels });
  const onFlow = (ask) => {
    const target = ask.command_id === 'shell.exec' ? `$ ${String(ask.params?.command ?? '').slice(0, 300)}` : ask.target;
    console.log(`[muse-node] flow: ${ask.command_id} approved by Flow mode`);
    phone?.notify(`⚡ Flow: ${ask.command_id}\n${target}`);
  };
  let stopping = false;
  let wake = null;
  let dropSession = null;
  const stop = () => { stopping = true; wake?.(); dropSession?.('daemon stopping'); };
  process.once('SIGINT', stop);
  process.once('SIGTERM', stop);
  process.on('SIGUSR2', () => {
    console.error('[muse-node] SIGUSR2: dropping the gateway session on purpose');
    dropSession?.('SIGUSR2 controlled disconnect');
  });
  let backoffMs = 1000;
  while (!stopping) {
    let session = null;
    let reason = 'unknown';
    try {
      session = await openGateway(profile, options);
      const { identity, connection, rpc } = session;
      const registry = createCommandRegistry({ approve, authority, receipts, flow, onFlow });
      const service = new MuseNodeService({ rpc, identity, registry, ledger, status });
      session.service = service;
      const ended = new Promise((resolve) => {
        dropSession = resolve;
        connection.ws.addEventListener('close', () => resolve(`gateway closed: ${JSON.stringify(connection.closeInfo)}`), { once: true });
        service.lost.then(resolve);
      });
      wake = () => dropSession?.('daemon stopping');
      const { registration } = await service.start();
      console.log(`[muse-node] online as ${identity.displayName}: ${JSON.stringify(registration)}`);
      console.log(`[muse-node] commands: ${Object.keys(registry.definitions).join(', ')}`);
      if (status.state === 'READY') backoffMs = 1000;
      reason = await ended;
    } catch (error) {
      reason = `session failed: ${error.message}`;
      status.error(reason);
    } finally {
      dropSession = null;
      await session?.service?.close();
      session?.rpc.close();
      session?.connection.close();
    }
    if (stopping) break;
    console.error(`[muse-node] ${reason}; reconnecting`);
    if (['CONNECTING', 'REGISTERED', 'READY'].includes(status.state)) status.transition('DEGRADED', reason);
    status.transition('RECONNECTING', reason);
    const delay = backoffWithJitter(backoffMs);
    console.error(`[muse-node] reconnect in ${delay} ms (${ledger.running} command(s) still running)`);
    await new Promise((resolve) => { wake = resolve; setTimeout(resolve, delay); });
    backoffMs = Math.min(backoffMs * 2, 60000);
  }
  await phone?.stop();
  const killed = killAllProcessGroups('SIGTERM');
  if (killed) console.error(`[muse-node] stopping: sent SIGTERM to ${killed} shell.exec process group(s)`);
  status.transition('DISCONNECTED', 'daemon stopped');
}

function telegramTransport() {
  let cached = null;
  return new telegram.TelegramTransport({ token: () => (cached ??= keyring.getSecret(TELEGRAM_ACCOUNT)) });
}

// Paired private chat -> approval channel; anything missing -> desktop only.
function openTelegramChannel({ flow, authority }) {
  let peer;
  try { peer = telegram.readPeer(); } catch (error) { console.error(`[muse-node] telegram: ${error.message}; desktop approvals only`); return null; }
  if (!peer) { console.log('[muse-node] telegram: not paired (muse-node telegram pair); desktop approvals only'); return null; }
  return new telegram.TelegramApprovals({ transport: telegramTransport(), peer, flow, authority });
}

function prompt(question, { hidden = false } = {}) {
  const readline = require('node:readline');
  return new Promise((resolve, reject) => {
    if (!process.stdin.isTTY) { reject(new Error('this step needs an interactive terminal')); return; }
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });
    if (hidden) rl._writeToOutput = (text) => { if (text.includes(question)) process.stdout.write(text); };
    rl.question(question, (answer) => { rl.close(); if (hidden) process.stdout.write('\n'); resolve(answer.trim()); });
  });
}

async function telegramCommand(sub, args) {
  if (sub === 'pair') {
    console.log('1) En Telegram abre @BotFather, envía /newbot y copia el token que te da.');
    const token = await prompt('2) Pega aquí el token (no se ve, no se guarda en archivos): ', { hidden: true });
    if (!telegram.TOKEN.test(token)) throw new Error('eso no parece un token de BotFather');
    const transport = new telegram.TelegramTransport({ token: () => token });
    const bot = await transport.getMe();
    await transport.ensurePolling();
    const pin = require('node:crypto').randomBytes(4).toString('hex');
    console.log(`3) Abre https://t.me/${bot.username} y envíale exactamente:\n\n     /pair ${pin}\n\n   (tienes 3 minutos)`);
    const who = await telegram.waitForPairing(transport, pin);
    const ok = await prompt(`Recibido de ${who.name || '?'}${who.username ? ` (@${who.username})` : ''}, id ${who.userId}. ¿Es tu cuenta? [s/N] `);
    if (!/^s(i|í)?$/i.test(ok)) throw new Error('vinculación cancelada');
    keyring.setSecret(TELEGRAM_ACCOUNT, token);
    const peer = new telegram.Peer({ bot_id: bot.id, user_id: who.userId, chat_id: who.userId });
    telegram.writePeer(peer);
    await transport.send(peer.chatId, `✅ Vinculado con muse-node en ${require('node:os').hostname()}.\nAquí te llegarán las aprobaciones. Escribe /estado para ver las opciones.`).catch(() => {});
    console.log(`Vinculado: bot @${bot.username} ↔ tu chat privado. Token en el keyring, vínculo en ${telegram.defaultPeerFile()}.`);
    console.log('Reinicia el daemon para usarlo:  systemctl --user restart muse-node.service');
  } else if (sub === 'status') {
    const peer = telegram.readPeer();
    if (!peer) { console.log('telegram: no vinculado (muse-node telegram pair)'); return; }
    const bot = await telegramTransport().getMe();
    console.log(JSON.stringify({ paired: true, bot: `@${bot.username}`, bot_id: peer.botId, user_id: peer.userId, peer_file: telegram.defaultPeerFile() }, null, 2));
  } else if (sub === 'unpair') {
    try { fs.unlinkSync(telegram.defaultPeerFile()); } catch (error) { if (error.code !== 'ENOENT') throw error; }
    keyring.deleteSecret(TELEGRAM_ACCOUNT);
    console.log('telegram desvinculado (token borrado del keyring). Reinicia el daemon.');
  } else if (sub === 'test') {
    // Sends a sample approval that executes NOTHING, to check the buttons.
    const peer = telegram.readPeer();
    if (!peer) throw new Error('no vinculado: muse-node telegram pair');
    const phone = new telegram.TelegramApprovals({ transport: telegramTransport(), peer, ttlMs: 110000 });
    phone.start();
    for (let i = 0; i < 50 && !phone.available(); i++) await new Promise((resolve) => setTimeout(resolve, 200));
    if (!phone.available()) { await phone.stop(); throw new Error('Telegram no responde (¿otro proceso está leyendo el bot? para el daemon antes del test)'); }
    const digest = require('node:crypto').createHash('sha256').update(`test ${Date.now()}`).digest('hex');
    console.log('Mensaje de prueba enviado: pulsa Permitir o Rechazar en el celular (110 s)…');
    const answer = await phone.ask({ command_id: 'shell.exec', params: { command: 'echo "prueba de aprobación: no se ejecuta nada"', cwd: '~' }, digest });
    await phone.stop();
    console.log(`respuesta: ${answer === null ? 'sin respuesta (caducó)' : JSON.stringify(answer)}`);
  } else {
    throw new Error('usage: muse-node telegram pair|status|test|unpair');
  }
}

function flowCommand(sub, args) {
  const flow = new FlowMode({ file: flowFile() });
  if (sub === 'on') {
    const shell = args.includes('--shell');
    const state = flow.enable(parseMinutes(args.find((arg) => !arg.startsWith('--')) ?? '30'), 'terminal', shell ? 'all' : 'write');
    console.log(`Flow ON (${state.scope === 'all' ? 'escritura + terminal' : 'escritura'}) hasta ${state.until}: sin pedir permiso DENTRO de las carpetas ya autorizadas (muse-node policy). Credenciales siguen negadas. Apagar: muse-node flow off`);
    if (shell) console.log('AVISO: con --shell, un comando aprobado por Flow corre con todo tu poder de usuario.');
  } else if (sub === 'off') {
    flow.disable();
    console.log('Flow OFF: vuelvo a pedir permiso.');
  } else if (!sub || sub === 'status') {
    console.log(JSON.stringify(flow.status()));
  } else {
    throw new Error('usage: muse-node flow on [30m|2h] [--shell] | off | status');
  }
}

// Operator commands. They run in the operator's terminal, never through a
// model-reachable command: grants are a human decision.
function authorityCommand(command, args) {
  const authority = new WorkspaceAuthority();
  const actionsFor = (name) => GRANT_ALIASES[name] ?? [name];
  if (command === 'policy') {
    console.log(JSON.stringify({ policy_file: authority.policyPath, ...authority.policy() }, null, 2));
  } else if (command === 'grant') {
    const [name, ...paths] = args;
    if (!name) throw new Error('usage: muse-node grant read|write|shell|which|<action-id> [folder...]');
    for (const actionId of actionsFor(name)) {
      const needsPaths = actionId.startsWith('workspace.');
      if (needsPaths && !paths.length) throw new Error(`${actionId} needs at least one folder`);
      const current = authority.policy().grants[actionId]?.path_prefixes ?? [];
      const grant = authority.setGrant(actionId, { enabled: true, ...(needsPaths ? { pathPrefixes: [...current, ...paths] } : {}) });
      console.log(`granted ${actionId}${grant.path_prefixes ? ` in ${grant.path_prefixes.join(', ')}` : ''}`);
    }
  } else if (command === 'revoke') {
    const [name] = args;
    if (!name) throw new Error('usage: muse-node revoke read|write|shell|which|<action-id>');
    for (const actionId of actionsFor(name)) { authority.setGrant(actionId, { enabled: false, pathPrefixes: [] }); console.log(`revoked ${actionId}`); }
  } else if (command === 'lock' || command === 'unlock') {
    authority.setLocked(command === 'lock');
    console.log(command === 'lock' ? 'LOCKED: every command except ping is denied' : 'unlocked');
  } else if (command === 'receipts') {
    if (args.includes('--verify')) { console.log(JSON.stringify(ReceiptLog.verify(receiptsFile()))); return; }
    const count = Number(args.find((value) => /^\d+$/.test(value)) ?? 20);
    try { process.stdout.write(fs.readFileSync(receiptsFile(), 'utf8').trimEnd().split('\n').slice(-count).join('\n') + '\n'); }
    catch (error) { if (error.code === 'ENOENT') console.log('no receipts yet'); else throw error; }
  }
}

function printStatus() {
  try { process.stdout.write(fs.readFileSync(defaultStatusPath(), 'utf8')); }
  catch (error) { console.error(`[muse-node] no status yet (${error.code ?? error.message}): is the daemon running?`); process.exitCode = 1; }
}

function stayMs() {
  const argument = process.argv.find((value) => value.startsWith('--stay-ms='));
  return argument ? Number(argument.split('=')[1]) : 0;
}

async function main() {
  const command = process.argv[2] ?? 'probe';
  const profile = defaultProfile();
  if (command === 'identity') {
    const identity = loadOrCreateIdentity(profile);
    console.log(JSON.stringify({ nodeId: identity.nodeId, displayName: identity.displayName, platform: identity.platform, profile: path.join(profile, 'node-identity.json') }, null, 2));
    return;
  }
  if (command === 'status') return printStatus();
  if (command === 'telegram') return telegramCommand(process.argv[3], process.argv.slice(4));
  if (command === 'flow') return flowCommand(process.argv[3], process.argv.slice(4));
  if (['policy', 'grant', 'revoke', 'lock', 'unlock', 'receipts'].includes(command)) return authorityCommand(command, process.argv.slice(3));
  const options = { cold: process.argv.includes('--cold'), stayMs: stayMs() };
  if (command === 'probe') return probe(profile, options);
  if (command === 'register') return register(profile, options);
  if (command === 'nodes') return nodes(profile, options);
  if (command === 'start') return start(profile, options);
  throw new Error(`Unknown command: ${command}`);
}

main().catch((error) => {
  console.error(`[muse-node] ${error.message}`);
  process.exitCode = 1;
});
