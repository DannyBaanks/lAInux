# shellcheck shell=bash
# Pinned inputs of the Muse recipe. Muse (Meta, internal com.meta.endo) ships a
# macOS-NATIVE SwiftUI+Rust app (no Electron), so this recipe builds a NATIVE
# Linux protocol client instead: the DMG is only an RE/asset reference on the
# user's machine, nothing from it is ever redistributed.
# Hashes computed from Danny's own downloads on 2026-11-27.

MUSE_TITLE="Muse"                       # launcher / window class
MUSE_PORT_TITLE="Muse Desktop (Meta)"   # name for agent-facing host notes

# Supplied by the user (Meta download), never fetched here.
MUSE_VERSION="14.1"
MUSE_DMG_NAME="Muse-14.1.dmg"
MUSE_DMG_SHA256="af5e2bbc7dda9490bb7ddcf5cbedbb5289281fac9b2f8be0fdb428e56ace6985"

# Comparanda: previous build, for protocol diffs (login/TTS/topic drift).
MUSE_OLD_VERSION="11.1"
MUSE_OLD_DMG_NAME="Muse-11.1.dmg"
MUSE_OLD_DMG_SHA256="f8e49acc1b10b221d27757cf1ba4a3b0e2f6363082a4d0be67e55c597f8ecc2b"

# Runtime pin for the v0 shell: same artefact Manus already pins (hash from the
# publisher's SHASUMS256.txt, verified 2026-11-13).
ELECTRON_VERSION="43.6.0"
ELECTRON_URL="https://github.com/electron/electron/releases/download/v$ELECTRON_VERSION/electron-v$ELECTRON_VERSION-linux-x64.zip"
ELECTRON_SHA256="3075c82d0749e136bca77563d4dd24e881714d17d98241fafd02320da5d6e237"

MUSE_CLIENT_VERSION="0.1.0"
